# Copie para .env e preencha. O .env não é versionado.
POSTGRES_DB=myhobbies
POSTGRES_USER=troque_aqui
POSTGRES_PASSWORD=troque_aqui

# Endereço usado nos links enviados por e-mail.
APP_URL=http://localhost:8080

# Local: Mailpit, sem autenticação. Em produção, use o servidor real,
# por exemplo SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_TLS=on, SMTP_USER e SMTP_PASSWORD.
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_TLS=off
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=nao-responda@myhobbies.local
